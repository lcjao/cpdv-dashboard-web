# CPDV Dashboard Backend 配置样例（G12）
# 复制为 backend/.env 或系统环境变量；同名 env 优先于默认值。
# 留空的 key 会回退到 config.py 内的 hardcode 默认（仅作本机调试）。

# 1. 论文代码仓库根目录（含 scripts/04_cpdv_analysis.py 与 simulation/）
CPDV_CODE_ROOT=D:\研\土木水利\论文\代码\github

# 2. venv 隔离的 Python 解释器（必须含 numpy<2 + matplotlib<3.8 + torch 1.13+cpu）
CPDV_PYTHON_EXE=D:\python\cpdv-venv\Scripts\python.exe

# 3. 看板工作区（含 看板原型/dashboard_data.js）
CPDV_DASHBOARD_WORKSPACE=D:\Documents\Obsidian\O1\桥梁健康系统\Area\多桥梁损伤看板

# 4. 后端数据目录（registry.json / records.jsonl 落盘位置）
CPDV_DATA_DIR=./backend/data

# 5. 子进程默认超时（秒）。长 train 可临时拉到 900。
CPDV_DEFAULT_TIMEOUT=300
